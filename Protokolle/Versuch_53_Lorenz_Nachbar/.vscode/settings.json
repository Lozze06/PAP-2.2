{
    // Beim Speichern einer Kapiteldatei wird die erkannte Hauptdatei main.tex gebaut.
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.build.forceRecipeUsage": true,
    "latex-workshop.latex.build.rootfileInStatus": true,

    // Die Kapiteldateien verweisen über % !TeX root auf ../main.tex.
    // So bleibt main.tex die Root-Datei, auch wenn eine Kapiteldatei geöffnet ist.
    "latex-workshop.latex.rootFile.useSubFile": false,
    "latex-workshop.latex.rootFile.doNotPrompt": true,

    // Ausgabeordner ist der Projektordner; main.pdf liegt neben main.tex.
    "latex-workshop.latex.outDir": "%DIR%",
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (pdfLaTeX + BibTeX)",
            "tools": ["latexmk"]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "env": {}
        }
    ],
    "latex-workshop.view.pdf.viewer": "tab",
    "files.encoding": "utf8"
}
